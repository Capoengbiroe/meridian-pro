# Meridian Pro — environment template
# Copy to .env and fill in real values.

# ===== Database (Neon.tech PostgreSQL) =====
# Create a free project at https://neon.tech
# DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ===== Encryption master key (generate with: openssl rand -hex 32) =====
ENCRYPTION_KEY="change-me-to-a-32-byte-hex-string"

# ===== LLM / OpenRouter =====
OPENROUTER_API_KEY="sk-or-..."
MANAGEMENT_MODEL="openrouter/healer-alpha"
SCREENING_MODEL="openrouter/hunter-alpha"

# ===== Agent runtime =====
AGENT_USER_ID="your-primary-user-id"
WALLET_PUBLIC_KEY=""
RPC_URL="https://pump.helius-rpc.com"
DRY_RUN="true"

# ===== Optional integrations =====
HELIUS_API_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
LPAGENT_API_KEY=""
HIVE_MIND_URL=""
HIVE_MIND_API_KEY=""